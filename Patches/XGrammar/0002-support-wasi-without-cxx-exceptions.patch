new file mode 100644
index 0000000..f234813
--- /dev/null
+++ b/cpp/support/no_exceptions.h
@@ -0,0 +1,21 @@
+/*!
+ * Copyright (c) 2026 by Contributors
+ * \file xgrammar/support/no_exceptions.h
+ * \brief Exception-runtime compatibility configuration.
+ */
+#ifndef XGRAMMAR_SUPPORT_NO_EXCEPTIONS_H_
+#define XGRAMMAR_SUPPORT_NO_EXCEPTIONS_H_
+
+#if defined(XGRAMMAR_CXX_EXCEPTIONS_ENABLED) && !XGRAMMAR_CXX_EXCEPTIONS_ENABLED
+#ifdef __cpp_exceptions
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wbuiltin-macro-redefined"
+#undef __cpp_exceptions
+#pragma clang diagnostic pop
+#endif
+#ifndef PICOJSON_DISABLE_EXCEPTION
+#define PICOJSON_DISABLE_EXCEPTION 1
+#endif
+#endif
+
+#endif  // XGRAMMAR_SUPPORT_NO_EXCEPTIONS_H_
